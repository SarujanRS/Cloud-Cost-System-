# Core app settings
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_SECRET_KEY=change-me-in-production
FLASK_COOKIE_SECURE=1
FLASK_HTTPS=0
APP_PORT=5000

# Database (production should use PostgreSQL or MySQL)
DATABASE_ENGINE=postgresql
DATABASE_URL=postgresql://app_user:change_me@db:5432/multicloud_cost_system

# Security
SESSION_TIMEOUT_MINUTES=120
CORS_ORIGINS=https://app.example.com

# Observability / monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=1
LOG_LEVEL=INFO

# Budget / cost controls
BUDGET_ALERT_THRESHOLD=0.8
BUDGET_ALERT_EMAIL=finance@example.com
ANOMALY_DEVIATION_FACTOR=2.0
